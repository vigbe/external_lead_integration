<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--
            Odoo 16-18 security pattern:
              1. ir.module.category -> visible section under Settings > Users
              2. res.groups (category_id) -> the actual group.

            NOTE: this branch targets pre-19 series. Odoo 19 replaced
            ``category_id`` on res.groups with the res.groups.privilege bridge;
            see the main branch for that pattern.
        -->
        <record id="module_category_external_lead_integration" model="ir.module.category">
            <field name="name">External Lead Integration</field>
            <field name="sequence">50</field>
        </record>

        <record id="group_external_lead_admin" model="res.groups">
            <field name="name">External Lead Integration: Administrator</field>
            <field name="category_id" ref="module_category_external_lead_integration"/>
            <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
            <field name="comment">Can manage External Lead API keys and settings.</field>
        </record>

        <!-- Sales managers automatically become External Lead administrators. -->
        <record id="sales_team.group_sale_manager" model="res.groups">
            <field name="implied_ids" eval="[Command.link(ref('group_external_lead_admin'))]"/>
        </record>
    </data>
</odoo>
